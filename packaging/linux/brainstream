#!/bin/sh
# Start brAIn stream from its unpacked (or installed) folder.
#
# The folder carries its own Python and the wheels of brAIn stream and
# OpenGP3, but not g.Pype or g.tec's gtec-unicorn driver:
# their licences do not allow them in a bundle. On first launch, and after
# an update, bootstrap.py installs them and the other libraries from PyPI
# into ~/.local/share/brainstream/runtime.
set -u

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PYTHON="$HERE/python/bin/python3"
BUILD="$(cat "$HERE/build-id")"
LIB="${XDG_DATA_HOME:-$HOME/.local/share}/brainstream/runtime/$BUILD"

if [ ! -f "$LIB/.complete" ]; then
    "$PYTHON" -I "$HERE/bootstrap.py" "$HERE" "$LIB" || exit 1
fi

exec "$PYTHON" -I -c '
import sys
sys.path.insert(0, sys.argv.pop(1))
sys.argv[0] = "brainstream"
from brainstream.app import main
sys.exit(main())
' "$LIB" "$@"
